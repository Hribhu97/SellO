rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Public read for product images and shop logos
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnder5MB();
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnder5MB();
    }
  }
}
